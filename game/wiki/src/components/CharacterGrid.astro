---
// Grille des personnages publics (nom + portrait) avec lien vers leur fiche.
import { getCollection } from 'astro:content';
import { mediaUrl, mediaInfo } from '../lib/media';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const list = (await getCollection('characters')).filter((c) => c.data.unlock === 'public' && c.data.page && c.data.portrait && !c.data.page.endsWith('autres/'));
---

<ul class="char-grid">
  {list.map((c) => (
    <li>
      <a class="char-card" href={base + c.data.page} style={c.data.color ? `--char:${c.data.color}` : undefined}>
        <img src={mediaUrl(c.data.portrait!)} alt="" width={mediaInfo(c.data.portrait!)?.w} height={mediaInfo(c.data.portrait!)?.h} loading="lazy" />
        <span>{c.data.name}</span>
      </a>
    </li>
  ))}
</ul>
